[Unit]
Description=Sentinel control plane
After=network.target

[Service]
Type=simple
# Adjust to wherever you cloned the repo.
WorkingDirectory=/opt/sentinel
ExecStart=/opt/sentinel/venv/bin/python app.py
Restart=always
RestartSec=5

# Sentinel only needs root for the power-control paths (Wake-on-LAN
# broadcast, `wg set`, relay GPIO). If you don't use those, run it as an
# unprivileged user by uncommenting these.
# User=sentinel
# Group=sentinel

[Install]
WantedBy=multi-user.target
